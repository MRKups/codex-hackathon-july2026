# Copy this file to .env, populate it, and run: source .env
# .env is ignored by Git; do not commit credentials.

# OpenAI-compatible API base URL. It may include a version path such as /v1.
export LLM_BASE_URL=""

# Secret API key for the provider.
export LLM_API_KEY=""

# Model identifier accepted by the chosen provider.
export LLM_MODEL=""

# Whole-call completion timeout, in Go duration syntax.
export LLM_TIMEOUT="30s"
