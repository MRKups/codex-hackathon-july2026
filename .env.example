# Copy this file to .env, populate it, and run: source .env
# .env is ignored by Git; do not commit credentials.

# Required provider adapter. The only registered value today is openai.
export LLM_PROVIDER="openai"

# OpenAI Chat Completions-compatible API base URL. It may include a version path such as /v1.
# The adapter passes this exact configured value to the official SDK.
export LLM_BASE_URL=""

# Secret API key for the selected provider.
export LLM_API_KEY=""

# Required default model identifier accepted by the chosen provider. It is used for any role
# when the role-specific setting below is blank, and remains required even when both role-specific
# settings are set.
export LLM_MODEL=""

# Optional comma-separated browser allowlist. Leave blank to offer LLM_MODEL plus any explicit
# role defaults below. If set, it must include the effective coder, test-writer, and reviewer defaults.
export LLM_MODELS=""

# Optional default model for the candidate-code writer. Falls back to LLM_MODEL.
export LLM_MODEL_CODER=""

# Optional default model for the blind test-writer. Falls back to LLM_MODEL.
export LLM_MODEL_TESTER=""

# Optional default model for the bounded generated-oracle reviewer. Falls back to the effective
# blind test-writer model. The browser cannot select it.
export LLM_MODEL_REVIEWER=""

# Whole-call completion timeout, in Go duration syntax.
export LLM_TIMEOUT="30s"
